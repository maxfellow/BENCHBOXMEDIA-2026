{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "benchboxmedia-2026.vercel.app" }], "destination": "https://benchboxmedia.com/:path*", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": { "suf": ".vercel.app" } }], "destination": "https://benchboxmedia.com/:path*", "permanent": true }
  ],
  "headers": [
    { "source": "/:path*", "has": [{ "type": "host", "value": { "suf": ".vercel.app" } }], "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
